--- a/agent/session_client_env.py
+++ b/agent/session_client_env.py
@@ -40,0 +41,16 @@ _BOUND: ContextVar = ContextVar('session_client_env', default=None)
+def prompt_client_env(environ, names):
+    """Prototype: explicit local ACP tool names, never a system-prompt overlay."""
+    import re
+    if not isinstance(names, list) or len(names) > _MAX_NAMES or any(
+            not isinstance(n, str) or re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', n) is None
+            or not _travels(n) for n in names):
+        raise ValueError('invalid client tool environment names')
+    return normalise_client_env({n: environ[n] for n in names if n in environ}, None)
+
+
+def admitted_tool_env():
+    from gateway.session_cli_turn import _cli_turn
+    bound = _cli_turn.get()
+    return {} if bound is None else dict(bound[1].get('client_tool_env', {}))
+
+
