diff --git a/tests/gateway/test_session_client_env.py b/tests/gateway/test_session_client_env.py
index 550394fc7c..fe60c40772 100644
--- a/tests/gateway/test_session_client_env.py
+++ b/tests/gateway/test_session_client_env.py
@@ -434,0 +435,34 @@ def test_auto_started_gateway_does_not_inherit_client_behaviour_env(tmp_path, mo
+
+
+def test_admission_tool_env_rotation_and_shell_snapshot(tmp_path):
+    """Issue #142671 prototype: a resumed shell and an old execution differ."""
+    from contextvars import copy_context
+    from gateway.session_cli_turn import admit_cli_turn, cli_turn_scope
+    from tools.environments.local import LocalEnvironment
+    first = admit_cli_turn({'client_tool_env': {'CLIENT_RUN_CONTEXT': 'old'}})['cli_turn_v1']
+    second = admit_cli_turn({'client_tool_env': {'CLIENT_RUN_CONTEXT': 'new'}})['cli_turn_v1']
+    with cli_turn_scope('old-admission', first):
+        shell = LocalEnvironment(cwd=str(tmp_path))
+        old_execution = copy_context()
+        result = shell.execute('printf "CTX:%s" "$CLIENT_RUN_CONTEXT"; export CLIENT_RUN_CONTEXT=stale_snapshot')
+        assert result['returncode'] == 0 and 'CTX:old' in result['output']
+    try:
+        with cli_turn_scope('new-admission', second):
+            result = shell.execute('printf "CTX:%s" "$CLIENT_RUN_CONTEXT"')
+            assert result['returncode'] == 0 and 'CTX:new' in result['output']
+            old_result = old_execution.run(shell.execute, 'printf "CTX:%s" "$CLIENT_RUN_CONTEXT"')
+            assert old_result['returncode'] == 0 and 'CTX:old' in old_result['output']
+    finally:
+        shell.cleanup()
+
+
+def test_prompt_env_names_are_explicit_nonsecret_and_retry_payload_is_distinct():
+    from agent.session_client_env import prompt_client_env
+    from gateway.session_cli_turn import admit_cli_turn
+    assert prompt_client_env({'CLIENT_RUN_CONTEXT': 'a', 'UNDECLARED': 'x'}, ['CLIENT_RUN_CONTEXT']) == {'CLIENT_RUN_CONTEXT': 'a'}
+    for name in ['PRIVATE_TOKEN', 'HERMES_HOME', 'not valid']:
+        with pytest.raises(ValueError):
+            prompt_client_env({name: 'x'}, [name])
+    a = admit_cli_turn({'client_tool_env': {'CLIENT_RUN_CONTEXT': 'a'}})
+    b = admit_cli_turn({'client_tool_env': {'CLIENT_RUN_CONTEXT': 'b'}})
+    assert a != b
